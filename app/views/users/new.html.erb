<div class="auth-container">
  <div class="auth-form">
    <h1>Create Account</h1>
    
    <% if @message.present? %>
      <div class="alert alert-error">
        <%= @message %>
      </div>
    <% end %>

    <%= form_with model: @user, url: sign_up_path, class: "form-group" do |form| %>
      <div class="form-field">
        <%= form.label :server_name, "Server Name" %>
        <%= form.text_field :server_name, required: true, placeholder: "Enter server name", class: "form-input" %>
      </div>

      <div class="form-field">
        <%= form.label :username %>
        <%= form.text_field :username, required: true, placeholder: "Choose a username", class: "form-input" %>
      </div>

      <div class="form-field">
        <%= form.label :password %>
        <%= form.password_field :password, required: true, placeholder: "Enter password", class: "form-input" %>
      </div>

      <div class="form-field">
        <%= form.label :password_confirmation, "Confirm Password" %>
        <%= form.password_field :password_confirmation, required: true, placeholder: "Confirm password", class: "form-input" %>
      </div>

      <%= form.submit "Sign Up", class: "btn btn-primary btn-block" %>
    <% end %>

    <div class="auth-footer">
      <p>Already have an account? <%= link_to "Sign in", login_path %></p>
    </div>
  </div>
</div>