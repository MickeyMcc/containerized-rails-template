<div class="auth-container">
  <div class="auth-form">
    <h1>Sign In</h1>

    <%= form_with url: login_path, scope: :user, class: "form-group" do |form| %>
      <div class="form-field">
        <%= form.label :username %>
        <%= form.text_field :username, required: true, placeholder: "Enter your username", class: "form-input" %>
      </div>

      <div class="form-field">
        <%= form.label :password %>
        <%= form.password_field :password, required: true, placeholder: "Enter your password", class: "form-input" %>
      </div>

      <%= form.submit "Sign In", class: "btn btn-primary btn-block" %>
    <% end %>

    <div class="auth-footer">
      <p>Don't have an account? <%= link_to "Sign up", sign_up_path %></p>
    </div>
  </div>
</div>